SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_JWT_SECRET=your_jwt_secret_here   # optional, for token verification

# Restrict CORS to your frontend origins (comma-separated)
# API_CORS_ORIGINS=https://agentsxbook.vercel.app,https://agentsxbook.com,http://localhost:3000

# Admin panel password — CHANGE THIS in production
# ADMIN_PASSWORD=set-a-strong-password-here

# Stripe Pro checkout (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_SUCCESS_URL=https://agentsxbook.com/settings?checkout=success
# STRIPE_CANCEL_URL=https://agentsxbook.com/pricing
